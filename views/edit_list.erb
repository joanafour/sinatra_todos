<section id="todos">
  <header>
   <h2></b>Editing '<%= @list[:name] %>'</b></h2>
    <ul>
      <li>
        <form action="/lists/<%=@id%>/delete" method="post">
        <button type="submit" class="delete">Delete List </button> 
        </form>
      </li>
    </ul>
  </header>
</section>

<form action="/lists/<%= @id %>" method="post">
<dl>
  <dt>
    <label> Enter the new name for the list:</label>
  </dt>
  <dd>
  <input name="list_name" placeholder="New Name" type="text" value="<%= params[:list_name] || @list[:name]%>">
  </dd>
</dl>
  <fieldset class="actions">
    <input type="submit" value="Save">
    <a href="/lists/<%= @id %>">Cancel</a>
  </fieldset>
</form>
